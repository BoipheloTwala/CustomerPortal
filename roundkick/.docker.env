# Docker Environment Configuration
# This file contains environment variables for Docker deployment

# MongoDB Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=secure_password_change_in_production

# JWT Configuration
JWT_SECRET=customer-portal-production-secret-key-change-this-immediately

# CORS Configuration
CORS_ORIGIN=https://localhost:3000,https://localhost:5173

# Redis Configuration (optional)
REDIS_PASSWORD=secure_redis_password_123

# SSL Configuration (for production)
SSL_CERT_PATH=/etc/ssl/certs/customer-portal.crt
SSL_KEY_PATH=/etc/ssl/private/customer-portal.key
