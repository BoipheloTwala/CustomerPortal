# Server Configuration
# Port for the server (default: 5000)
PORT=5000

# Environment (development, production, test)
NODE_ENV=development

# Database Configuration
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/customer_portal

# SSL/TLS Configuration
# Set to 'true' to force HTTPS mode, 'false' for HTTP only
# If not set, server will auto-detect based on certificate availability
FORCE_SSL=false

# SSL Certificate paths (optional - server will auto-generate if not provided)
SSL_KEY_PATH=./cert/localhost-key.pem
SSL_CERT_PATH=./cert/localhost.pem

# JWT Configuration
# Secret key for JWT token signing (REQUIRED - generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiration time (default: 24h)
JWT_EXPIRES_IN=24h

# Security Configuration
# Enable/disable specific security features
ENABLE_RATE_LIMITING=true
ENABLE_CSRF_PROTECTION=true
ENABLE_XSS_PROTECTION=true
ENABLE_NOSQL_INJECTION_PROTECTION=true

# CORS Configuration
# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost:5173

# Rate Limiting Configuration
# General rate limit (requests per window)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Auth-specific rate limiting
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Cloudflare Configuration (for production)
# Enable Cloudflare integration
ENABLE_CLOUDFLARE=false

# Cloudflare API token (if using Cloudflare features)
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Logging Configuration
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# Session Configuration
# Session secret (for session-based auth if implemented)
SESSION_SECRET=your-session-secret-change-this

# Password Configuration
# Minimum password length
MIN_PASSWORD_LENGTH=8

# Password complexity requirements
REQUIRE_PASSWORD_COMPLEXITY=true

# Email Configuration (for password reset, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=noreply@yourdomain.com

# Redis Configuration (for session storage, rate limiting)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Health Check Configuration
# Enable health check endpoint
ENABLE_HEALTH_CHECK=true

# Health check path
HEALTH_CHECK_PATH=/health