{
  "name": "customer-portal-backend",
  "version": "1.0.0",
  "description": "Secure customer portal backend with authentication and authorization",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "start": "node server.js",
    "build": "echo 'No build step required'",
    "test": "node tests/simple-test.js",
    "test:coverage": "node tests/simple-test.js && echo 'Coverage reporting not yet implemented'",
    "test:full": "node tests/run-tests.js",
    "lint": "echo 'Linting to be configured'",
    "security-audit": "npm audit --audit-level=moderate",
    "generate-certs": "node generate-certs.js"
  },
  "author": "Security Team",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "customer-portal",
    "authentication",
    "security",
    "express",
    "mongodb",
    "jwt"
  ],
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "isomorphic-dompurify": "^2.28.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.18.0",
    "mongoose": "^8.17.0",
    "rate-limiter-flexible": "^8.0.1",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.2.3",
    "nodemon": "^3.0.0",
    "selfsigned": "^3.0.1",
    "supertest": "^7.1.4"
  }
}
