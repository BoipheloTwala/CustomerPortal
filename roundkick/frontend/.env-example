# API Configuration
# Backend API URL - the application will auto-detect the correct protocol
# Set to HTTP for local development without SSL, HTTPS for SSL-enabled backend
VITE_API_URL=http://localhost:5000/api

# Alternative configurations:
# For HTTPS backend with SSL certificates:
# VITE_API_URL=https://localhost:5000/api
# For production deployment:
# VITE_API_URL=https://api.yourdomain.com/api

# App Configuration
VITE_APP_NAME=Secure Banking Portal
VITE_APP_VERSION=1.0.0

# Environment
VITE_NODE_ENV=development

# Feature Flags (optional)
# Enable/disable specific features
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
VITE_ENABLE_DEVTOOLS=true

# Security Configuration
# Enable anti-MITM protection
VITE_ENABLE_ANTI_MITM=true

# Enable XSS protection
VITE_ENABLE_XSS_PROTECTION=true

# API Configuration
# Request timeout in milliseconds
VITE_API_TIMEOUT=10000

# Enable automatic protocol fallback (HTTP <-> HTTPS)
VITE_ENABLE_PROTOCOL_FALLBACK=true

# Maximum retry attempts for failed requests
VITE_MAX_RETRY_ATTEMPTS=3

# CORS Configuration
# Allowed origins for CORS requests
VITE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Authentication Configuration
# JWT token storage key
VITE_AUTH_TOKEN_KEY=authToken

# User data storage key
VITE_USER_DATA_KEY=user

# Security token storage key
VITE_SECURITY_TOKEN_KEY=securityToken

# Session timeout in milliseconds (24 hours default)
VITE_SESSION_TIMEOUT=86400000

# UI Configuration
# Theme settings
VITE_THEME=light
# VITE_THEME=dark

# Enable dark mode toggle
VITE_ENABLE_DARK_MODE=true

# Default language
VITE_DEFAULT_LANGUAGE=en

# Performance Configuration
# Enable request caching
VITE_ENABLE_REQUEST_CACHE=true

# Cache duration in milliseconds (5 minutes default)
VITE_CACHE_DURATION=300000

# Enable service worker
VITE_ENABLE_SERVICE_WORKER=false

# Logging Configuration
# Enable console logging
VITE_ENABLE_CONSOLE_LOGS=true

# Log level (error, warn, info, debug)
VITE_LOG_LEVEL=info

# Enable network request logging
VITE_ENABLE_NETWORK_LOGS=false

# Development Tools
# Enable React DevTools
VITE_ENABLE_REACT_DEVTOOLS=true

# Enable Redux DevTools (if using Redux)
VITE_ENABLE_REDUX_DEVTOOLS=false

# Hot reload configuration
VITE_HOT_RELOAD=true

# Build Configuration
# Public path for assets
VITE_PUBLIC_PATH=/

# Enable source maps in development
VITE_ENABLE_SOURCE_MAPS=true

# Bundle analyzer
VITE_ENABLE_BUNDLE_ANALYZER=false

# Testing Configuration
# Enable test mode features
VITE_TEST_MODE=false

# Mock API responses
VITE_ENABLE_MOCK_API=false

# Test data configuration
VITE_USE_TEST_DATA=false